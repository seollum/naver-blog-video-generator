        {
            "parameters": {
                "mode": "runOnceForAllItems",
                "jsCode": "const srtText = $input.first().json.content?.parts?.[0]?.text || '';\nconst data = $('스크립트 추출').first().json;\nconst images = data.images || [];\nconst audioUrl = $('TTS 결과').first().json.audio?.url || '';\n\nconst lines = srtText.split('\\n\\n').filter(block => block.trim());\nconst scenes = [];\n\nlines.forEach((block, idx) => {\n  const match = block.match(/(\\d{2}:\\d{2}:\\d{2},\\d{3})\\s*-->\\s*(\\d{2}:\\d{2}:\\d{2},\\d{3})/);\n  if (match) {\n    const textLine = block.split('\\n').slice(1).join(' ').trim();\n    const startParts = match[1].split(/[:,]/).map(Number);\n    const endParts = match[2].split(/[:,]/).map(Number);\n    const startSec = startParts[0]*3600 + startParts[1]*60 + startParts[2] + startParts[3]/1000;\n    const endSec = endParts[0]*3600 + endParts[1]*60 + endParts[2] + endParts[3]/1000;\n    let duration = Math.ceil(endSec - startSec);\n    if (duration < 3) duration = 5;\n\n    scenes.push({\n      index: idx,\n      start: match[1],\n      end: match[2],\n      duration: duration,\n      text: textLine,\n      image_url: images[idx % images.length] || images[0] || ''\n    });\n  }\n});\n\nreturn [{\n  json: {\n    ...data,\n    srt: srtText,\n    audio_url: audioUrl,\n    scenes: scenes\n  }\n}];"
            },

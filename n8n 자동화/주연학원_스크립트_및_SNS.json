    {
      "parameters": {
        "jsCode": "// Regex를 사용하여 LinkedIn, Twitter, Instagram 콘텐츠 추출\nconst text = $input.item.json.message.content;\n\n// 정규식 패턴\nconst linkedinPattern = /(?<=Linkedin 게시물:)[\\s\\S]*?(?=\\s*---)/;\nconst tweetPattern = /(?<=Tweet 게시물:)[\\s\\S]*?(?=\\s*---)/;\nconst instagramPattern = /(?<=Instagram 게시물:)[\\s\\S]*?(?=\\s*$)/;\n\n// 매칭\nconst linkedinMatch = text.match(linkedinPattern);\nconst tweetMatch = text.match(tweetPattern);\nconst instagramMatch = text.match(instagramPattern);\n\n// 결과 배열 생성\nconst results = [];\n\nif (linkedinMatch) {\n  results.push({\n    json: {\n      platform: 'linkedin',\n      index: 0,\n      content: linkedinMatch[0].trim()\n    }\n  });\n}\n\nif (instagramMatch) {\n  results.push({\n    json: {\n      platform: 'instagram',\n      index: 1,\n      content: instagramMatch[0].trim()\n    }\n  });\n}\n\nif (tweetMatch) {\n  results.push({\n    json: {\n      platform: 'twitter',\n      index: 2,\n      content: tweetMatch[0].trim()\n    }\n  });\n}\n\nreturn results;"
      },

                "httpMethod": "POST",
                "path": "senior-audiobook",
                "responseMode": "responseNode",
                "options": {}
            }
        },
        {
            "id": "ai-director",
            "name": "AI Director",
            "type": "@n8n/n8n-nodes-langchain.openAi",
            "typeVersion": 2.1,
            "position": [
                220,
                0
            ],
            "parameters": {
                "resource": "text",
                "operation": "message",
                "modelId": {
                    "__rl": true,
                    "mode": "id",
                    "value": "gpt-4o"
                },
                "messages": {
                    "values": [
                        {
                            "content": "=당신은 시니어 오디오북 제작을 위한 콘텐츠 디렉터입니다.\n\n**[핵심 임무]**\n입력된 스크립트를 의미 단위로 분석하여 N개의 장면(Scene)으로 분할합니다.\n각 장면에 대해 시니어 친화적인 이미지 프롬프트를 자동 생성합니다.\n\n**[이미지 프롬프트 요구사항]**\n- 화풍: 따뜻한 수채화 스타일 (Warm watercolor painting style)\n- 대비: 높은 명암 대비로 시각적 명확성 확보\n- 색상: 부드럽고 안정감 있는 파스텔톤 위주\n- 구도: 단순하고 직관적인 구도, 복잡한 배경 지양\n- 키워드: \"Clear, soothing, high contrast for visibility, senior-friendly, nostalgic\"\n\n**[출력 형식]**\n반드시 아래 JSON 형식으로만 응답하세요:\n{\n  \"total_scenes\": N,\n  \"scenes\": [\n    {\n      \"scene_id\": 1,\n      \"text_chunk\": \"해당 장면의 오디오 대본 텍스트\",\n      \"image_prompt\": \"Warm watercolor style illustration of [장면 묘사], soft pastel colors, high contrast, nostalgic atmosphere, senior-friendly clear composition\",\n      \"estimated_duration\": 15\n    }\n  ]\n}\n\n**[제약사항]**\n- 각 장면의 text_chunk는 자연스러운 문장으로 끝나야 합니다\n- 장면당 예상 길이는 10-30초 사이로 조절\n- JSON 외의 다른 텍스트를 포함하지 마세요\n\n**[스크립트]**\n{{ $json.body.script }}",
                            "role": "user"
                        }
                    ]
                },
                "options": {
                    "temperature": 0.3,
                    "responseFormat": "json_object"
                }
            },
            "credentials": {
                "openAiApi": {
                    "id": "openai-creds",
                    "name": "OpenAI Account"
                }
            }
        },
        {
            "id": "parse-scenes",
            "name": "Parse Scenes",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                440,
                0
            ],
            "parameters": {
                "mode": "runOnceForAllItems",
                "language": "javaScript",
                "jsCode": "// Parse AI Director output and prepare scene data\nconst input = $input.first().json;\nconst webhookData = $('Webhook Trigger').first().json.body;\n\nlet parsedContent;\ntry {\n  // Handle both string and object responses\n  if (typeof input.content === 'string') {\n    parsedContent = JSON.parse(input.content);\n  } else {\n    parsedContent = input.content || input;\n  }\n} catch (e) {\n  throw new Error('AI Director 응답 파싱 실패: ' + e.message);\n}\n\nconst scenes = parsedContent.scenes || [];\n\n// Return each scene as separate item for loop processing\nreturn scenes.map((scene, index) => ({\n  json: {\n    scene_id: scene.scene_id,\n    text_chunk: scene.text_chunk,\n    image_prompt: scene.image_prompt,\n    estimated_duration: scene.estimated_duration || 15,\n    total_scenes: parsedContent.total_scenes,\n    title: webhookData.title,\n    voice: webhookData.voice || 'hyeon',\n    style: webhookData.style || 'watercolor'\n  }\n}));"
            }
        },

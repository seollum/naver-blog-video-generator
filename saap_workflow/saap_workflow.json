        {
            "id": "prepare-scene-data",
            "name": "Prepare Scene Data",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                2200,
                0
            ],
            "parameters": {
                "mode": "runOnceForAllItems",
                "language": "javaScript",
                "jsCode": "// Combine TTS and Image results for this scene\nconst items = $input.all();\nconst sceneData = $('Scene Loop').first().json;\n\n// Find TTS and Image results\nlet audioUrl = '';\nlet imageUrl = '';\nlet audioDuration = sceneData.estimated_duration;\n\nfor (const item of items) {\n  if (item.json.audio_url) {\n    audioUrl = item.json.audio_url;\n    audioDuration = item.json.duration || audioDuration;\n  }\n  if (item.json.images && item.json.images[0]) {\n    imageUrl = item.json.images[0].url;\n  }\n}\n\nreturn [{\n  json: {\n    scene_id: sceneData.scene_id,\n    text_chunk: sceneData.text_chunk,\n    audio_url: audioUrl,\n    image_url: imageUrl,\n    duration: audioDuration,\n    total_scenes: sceneData.total_scenes,\n    title: sceneData.title\n  }\n}];"
            }
        },
